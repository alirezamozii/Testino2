{
  "appId": "app.testino.desktop",
  "productName": "Testino",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "out/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": ["portable", "nsis"],
    "icon": "public/icon-512.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
