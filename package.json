{
  "name": "testino",
  "version": "2.0.8",
  "description": "سامانه آزمون‌یار و مرور هوشمند تستینو",
  "author": "Testino",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web",
    "build:web": "node scripts/bump-version.mjs --no-bump && node scripts/prepare-assets.mjs && next build --webpack && node scripts/build-sw.mjs",
    "release": "node scripts/ship.mjs",
    "ship": "node scripts/ship.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run benchmark",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "desktop:dev": "npm run build:web && electron electron/main.cjs",
    "desktop:dist": "npm run build:web && node scripts/package-desktop.mjs",
    "benchmark": "node scripts/benchmark-all.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@fontsource/vazirmatn": "5.2.8",
    "@hookform/resolvers": "5.9.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "5.102.8",
    "clsx": "2.1.1",
    "katex": "0.16.28",
    "lucide-react": "0.577.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.5.0",
    "zod": "4.3.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
